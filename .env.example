# .env.example — Шаблон змінних оточення для Manager сервісу.
# Скопіюй у .env і заповни РЕАЛЬНИМИ значеннями.
# НІКОЛИ не коміть .env у git.

# ── FastAPI Manager ────────────────────────────────────────────────
# Ключ доступу до Manager API (X-API-Key заголовок)
# Генерувати: python -c "import secrets; print(secrets.token_urlsafe(32))"
MANAGER_API_KEY=

# URL бази даних Менеджера (окрема від інстансів!)
# Формат: postgresql+asyncpg://user:password@host:port/dbname
MANAGER_DATABASE_URL=postgresql+asyncpg://manager_user:CHANGE_ME@localhost:5432/manager_db

# ── ARQ / Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Fernet шифрування секретів ─────────────────────────────────────
# Генерувати: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# КРИТИЧНО: Зберігати окремо від бази даних. При втраті — всі секрети нечитабельні.
ENCRYPTION_KEY=

# ── Середовище ────────────────────────────────────────────────────
ENV=development  # production — вимикає /docs ендпоінт

# ── Telegram алерти ───────────────────────────────────────────────
# Увімкнути алерти: true / false
ALERTS_ENABLED=false
# Токен бота для відправки алертів адміну
ALERT_BOT_TOKEN=
# Telegram chat_id адміна (отримати через @userinfobot)
ALERT_CHAT_ID=
# Cooldown між однотипними алертами (секунди, default=300)
ALERT_COOLDOWN_SEC=300
